import mysql.connector
from mysql.connector import Error

while True:
    print("Welcome to the Inventory Management System")
    print("1. Add Product to Inventory \n 2. Delete Product \n 3. Update Product \n 4. View Product \n 5. Exit")
    choose = input("Enter your Choice: ")
    if choose == "1":
        name = input("Enter Product Name: ")
        desc = input("Enter Product Description: ")
        price = input("Enter Product Price: ")
        qty = input("Enter Product Quantity: ")
        try:
            con = mysql.connector.connect(host="localhost", database="db_inventory", user="root", password="")
            query = "INSERT INTO tbl_product (ProductName, ProductDescription, ProductPrice, ProductQuantity) VALUES (%s, %s, %s, %s)"
            cursor = con.cursor()
            cursor.execute(query, (name, desc, price, qty))
            con.commit()
            cursor.close()
            print("Product added.")
        except Error as e:
            print(e)
        finally:
            if con.is_connected():
                con.close()
                print("Connection Closed")
    elif choose == "2":
        name = input("Enter Product Name that you want to delete: ")
        try:
            con = mysql.connector.connect(host="localhost", database="db_inventory", user="root", password="")
            query = "DELETE FROM tbl_product WHERE ProductName = %s"
            cursor = con.cursor()
            cursor.execute(query, (name,))
            con.commit()
            cursor.close()
            print("Product deleted.")
        except Error as e:
            print(e)
        finally:
            if con.is_connected():
                con.close()
                print("Connection Closed")
    elif choose == "3":
        old = input("Enter product name to update: ")
        new = input("Enter the new product name: ")
        try:
            con = mysql.connector.connect(host="localhost", database="db_inventory", user="root", password="")
            query = "UPDATE tbl_product SET ProductName = %s WHERE ProductName = %s"
            cursor = con.cursor()
            cursor.execute(query, (new, old))
            con.commit()
            cursor.close()
            print("Product updated.")
        except Error as e:
            print(e)
        finally:
            if con.is_connected():
                con.close()
                print("Connection Closed")
    elif choose == "4":
        try:
            con = mysql.connector.connect(host="localhost", database="db_inventory", user="root", password="")
            query = "SELECT * FROM tbl_product"
            cursor = con.cursor()
            cursor.execute(query)
            rows = cursor.fetchall()
            for row in rows:
                print(row)
            con.commit()
            cursor.close()
        except Error as e:
            print(e)
        finally:
            if con.is_connected():
                con.close()
                print("Connection Closed")
    elif choose == "5":
        print("Exiting the program. Goodbye!")
        break
    else:
        print("Invalid choice, please try again.")
          
